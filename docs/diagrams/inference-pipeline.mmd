flowchart TD
    I["标准 IMU：25 Hz 六轴、有效及排除掩码"] --> V["按物理缺失分段；保持时间位置"]
    V --> C{"选择运行模式"}
    C -->|incremental| F["FC1：60 秒核心 + 左右各至多 30 秒上下文"]
    C -->|whole_record| W["完整记录／有效段；最长 25 小时"]
    F --> A["SB1：加速度重力／动态特征"]
    A --> N["姿态：32 TCN + 32 Conv-BiGRU"]
    A --> P["运动：24 XGBoost，70 维特征"]
    N --> M["姿态与运动概率融合；24 个种子组合平均"]
    P --> M
    M --> O["四类时间线与累计时长"]
    W --> E["E7：整段 SB1 + 四个修正／证据头 + 状态推断"]
    E --> O
    V --> G["可选 GP2：步行范围门控 → 步事件检测"]
    G --> S["实验步数／步频、覆盖范围及独立进度"]
